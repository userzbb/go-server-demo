# Omega Server 环境变量配置模板

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=omega
PG_PASSWORD=omega123
PG_DATABASE=omega

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=omega
MONGO_PASSWORD=omega123
MONGO_DATABASE=omega

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 服务配置
SERVER_PORT=8888
LOG_LEVEL=debug

# JWT 密钥（生产环境必须修改）
JWT_SECRET=your-secret-key-here
